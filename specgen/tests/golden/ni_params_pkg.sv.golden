`timescale 1ns/1ps

`ifndef NI_PARAMS_PKG_SVH
`define NI_PARAMS_PKG_SVH

package ni_params_pkg;

  // AXI parameter defaults
  localparam int unsigned AXI_ID_WIDTH_DFLT   = 8;
  localparam int unsigned AXI_ADDR_WIDTH_DFLT = 48;
  localparam int unsigned AXI_DATA_WIDTH_DFLT = 256;

  // NoC parameter defaults
  localparam int unsigned NOC_NUM_VC_DFLT                   = 1;
  localparam int unsigned NOC_FLIT_WIDTH_DFLT               = 396;
  localparam int unsigned NOC_ROUTER_VC_DEPTH_DFLT          = 8;
  localparam int unsigned NOC_ROUTER_OUTPUT_FIFO_DEPTH_DFLT = 2;
  localparam int unsigned NOC_MESH_X_DIM_DFLT               = 4;
  localparam int unsigned NOC_MESH_Y_DIM_DFLT               = 4;

  // NMU depth defaults
  localparam int unsigned NMU_ROB_B_DEPTH_DFLT        = 32;
  localparam int unsigned NMU_ROB_R_DEPTH_DFLT        = 32;
  localparam int unsigned NMU_MAX_TXNS_PER_ID_DFLT    = 32;
  localparam int unsigned NMU_OUTSTANDING_DEPTH_DFLT  = 32;
  localparam int unsigned NMU_QUEUE_DEPTH_DFLT        = 16;
  localparam int unsigned NMU_DEPKT_Q_DEPTH_DFLT      = 16;
  localparam int unsigned NMU_ARBITER_FIFO_DEPTH_DFLT = 4;

  // NSU depth defaults
  localparam int unsigned NSU_QUEUE_DEPTH_DFLT                 = 16;
  localparam int unsigned NSU_META_BUFFER_MAX_OUTSTANDING_DFLT = 32;
  localparam int unsigned NSU_META_BUFFER_MAX_UNIQUE_IDS_DFLT  = 1;
  localparam int unsigned NSU_ARBITER_FIFO_DEPTH_DFLT          = 4;

  // Derived parameter defaults
  localparam int unsigned AXI_WSTRB_WIDTH_DFLT = 32;

endpackage

`endif // NI_PARAMS_PKG_SVH
