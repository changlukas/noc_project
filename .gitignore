# Per-host build overrides (CMAKE / DEPS_SRC / VERDI_HOME ...). Each machine
# keeps its own; never committed so the tracked command line stays identical.
/local.mk

# Build artifacts — everything lands under the top-level build/ tree
# (build/cmodel, build/verilator, build/vcs)
/build/
Testing/
ref_model/c_model/Testing/
# Legacy locations (pre build/-tree restructure); keep ignored so stale
# checkouts don't show noise
sim/verilator/obj_dir/
sim/verilator/obj_genamba/
ref_model/c_model/build/

# Temporary files
*.tmp
*.log

# Co-sim runtime artifacts (per-instance variants since multi-instance DPI refactor)
master_wrap_read_dump*.txt
w_beats_received_

# Editor/tool files
.vscode/

# Codex prompt files
.codex_*.txt

# Per-simulator run outputs (sim/verilator/output, sim/vcs/output)
sim/*/output/
# Generated stimulus: per-run-tag write.txt/read.txt, derived from the topology
# YAML by sim/tools/gen_test_patterns.py. Lives beside output/ rather than under
# BUILD_ROOT -- it is text, and only linked artifacts need the native filesystem.
sim/*/test_patterns/*
!sim/*/test_patterns/README.md
!sim/*/test_patterns/mesh_2x2/
sim/*/test_patterns/mesh_2x2/*
!sim/*/test_patterns/mesh_2x2/neighbor/
# Legacy run-output location
sim/output/
# Stray generated perf summary (canonical copy lives under sim/*/output/)
sim/verilator/perf.json



# Generated tb_top filelists (regenerated from build_config.mk's TB_TOP_SV_SRC
# by both sim flows; bakes in host-absolute paths so they must not be committed)
sim/filelist_*.f

# Generated SV: tb_top_<TOPOLOGY>.sv is emitted by sim/tools/gen_tb_top.py on
# every build (the $(TB_TOP_SV) rule in both sim/verilator/Makefile and
# sim/vcs/Makefile regenerates it). Edit the generator or sim/topologies/*.yaml,
# never these files directly. The fabric they instantiate,
# ref_model/top/noc_fabric.sv, is one parameterized module and IS tracked.
sim/tb/test/tb_top_*.sv
sim/tb/soc/tb_top_dma_*.sv

# Local Python installs (project-local 3.14, ~278 MB total)
/Python/
/specgen/Python/

# Codegraph MCP database
/.codegraph/

# User-local workspace (kept local-only by default)
/dpi_ref/
/issue/

# Python tooling caches
/.pytest_cache/
__pycache__/
*.py[cod]

# Cross-AI review artifacts (transient; not normative)
/cross-review/

# Local-only doc references (not version-controlled)
/docs/probe_section_layout_draft.md
/docs/backlog.md

# SDD scratch (ledger, briefs, reports, codex reviews) — not version-controlled
/.superpowers/

# saturation sweep outputs (make sim-saturation)
sim/tools/saturation.csv
sim/tools/saturation.png

# injection-rate sweep outputs (make sim-injection-sweep)
sim/tools/injection_sweep.csv
sim/tools/injection_sweep.png
sim/tools/injection_sweep_dark.png

# Knowledge-base binaries and derived index. Text extractions are tracked so the
# corpus travels with the repository; the source PDFs and the embedding index are
# rebuildable from the manifest and the extraction scripts.
kb/corpus/*.pdf
kb/index.npz
