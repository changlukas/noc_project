 x="830" y="442" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n89" value="noc_wide_flit_o   [WIDE_FLIT_WIDTH]" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.4;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="280" y="464" as="sourcePoint"/><mxPoint x="830" y="464" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n90" value="noc_wide_credit_i   [NUM_VC]" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.4;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="486" as="sourcePoint"/><mxPoint x="280" y="486" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n91" value="noc_wide_valid_i   [1]" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.4;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="508" as="sourcePoint"/><mxPoint x="280" y="508" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n92" value="noc_wide_flit_i   [WIDE_FLIT_WIDTH]" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.4;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="530" as="sourcePoint"/><mxPoint x="280" y="530" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n93" value="noc_wide_credit_o   [NUM_VC]" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.4;fontSize=10;verticalAlign=bottom;labelBackgroundColor=none;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="280" y="552" as="sourcePoint"/><mxPoint x="830" y="552" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n94" value="Suffix o is driven by the network interface, suffix i by the router. A flit is accepted on the cycle valid is high and the sender holds a credit for the target virtual channel. Credit returns are one pulse per freed buffer, one bit per virtual channel, so the width follows NUM_VC.

WIDE_FLIT_WIDTH = 9 + 9 W_DATA / 8 + 56, giving 353 b at W_DATA 256, 641 b at 512, and 1217 b at 1024. REQ_FLIT_WIDTH and RSP_FLIT_WIDTH do not depend on W_DATA." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="90" y="600" width="950" height="88" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>